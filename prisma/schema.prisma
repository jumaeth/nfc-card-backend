generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

// Staff roles for the admin console. USER = regular customer account. SALES =
// manages only the companies assigned to them (Company.salesRep). SUPPORT = reads
// every customer, cannot change them. ADMIN / SUPER_ADMIN = manage everything.
enum PlatformRole {
  USER
  SALES
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

// Role a user holds inside a single tenant (Company). OWNER > ADMIN > MEMBER.
enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
}

enum Permission {
  MANAGE_CARDS
  MANAGE_BILLING
}

enum PlanTier {
  STARTER
  PRO
  MANAGED
}

enum BillingInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
}

// How a subscription came to exist. STRIPE = self-serve checkout + webhooks.
// MANUAL = assigned by platform staff (a comp). SYSTEM = the free plan every
// company gets on creation.
enum SubscriptionSource {
  STRIPE
  MANUAL
  SYSTEM
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// The product/experience a physical NFC card is sold as. Mirrors the site's
// product range: a Google review card, a live digital menu, a link hub, a
// contact (vCard) card, or a one-tap WiFi card.
enum CardType {
  REVIEW
  MENU
  LINKHUB
  VCARD
  WIFI
}

// Lifecycle of a physical card. UNASSIGNED = printed/stocked but not yet linked
// to a destination; ACTIVE = live and routing taps; DISABLED = temporarily off.
// Shop order lifecycle. PENDING_PAYMENT until Stripe confirms; EXPIRED when the
// checkout was abandoned (stock is released).
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  SHIPPED
  CANCELLED
  EXPIRED
}

enum CardStatus {
  UNASSIGNED
  ACTIVE
  DISABLED
}

// The kind of tap destination a Page renders. One Page model holds all builder
// content as validated JSON keyed by this discriminator.
enum PageKind {
  REVIEW
  MENU
  LINKHUB
  VCARD
  WIFI
}

// ─── Auth (managed by better-auth — do not rename fields) ────────────────────

model User {
  id            String       @id
  name          String       @default("")
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  avatarUrl     String?
  platformRole  PlatformRole @default(USER)
  // Soft-delete marker. Account deletion archives the user (keeps the row and
  // its business data) so it can be reclaimed on re-registration. null = active.
  deletedAt     DateTime?

  sessions Session[]
  accounts Account[]
  passkeys Passkey[]

  companyMembers  CompanyMember[]
  invitationsSent Invitation[]
  // Customers (companies) this user looks after as a SALES rep.
  salesCustomers  Company[]       @relation("CompanySalesRep")
  // Shop orders this staff member claimed in the admin console.
  handledOrders   Order[]         @relation("OrderHandler")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
}

model Session {
  id         String   @id
  expiresAt  DateTime
  token      String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ipAddress  String?
  userAgent  String?
  // How this session authenticated: password | passkey | google | email-otp.
  authMethod String?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

// WebAuthn/FIDO2 passkey credential, managed by better-auth's passkey plugin.
// NOT under row-level security: read/written pre-tenant-context during sign-in.
model Passkey {
  id           String   @id
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
}

// ─── Company (tenant) ────────────────────────────────────────────────────────

model Company {
  id            String   @id @default(cuid())
  name          String
  // Short name in card links: /c/<slug>/<card slug>.
  slug          String   @unique
  // Slugs this company used before. Printed cards carry them, so they keep
  // resolving here and no other company can take them.
  previousSlugs String[] @default([])
  logo          String?
  billingEmail  String?
  // Default brand colours applied to new pages/cards (Taplino accent by default).
  brandColor    String   @default("#2f6df0")
  // Staff override: pages stay live and editable even when the plan does not
  // include them. Without it, pages on such a plan are read-only and offline.
  pagesOverride Boolean  @default(false)

  // The Taplino sales rep who owns this customer. Scopes the admin console for
  // SALES staff; null = unassigned (only SUPPORT/ADMIN see it).
  salesRepId String?
  salesRep   User?   @relation("CompanySalesRep", fields: [salesRepId], references: [id], onDelete: SetNull)

  members          CompanyMember[]
  locations        Location[]
  cards            Card[]
  orders           Order[]
  pages            Page[]
  translationUsage TranslationUsage[]
  designTemplates  DesignTemplate[]
  wifiGuests       WifiGuest[]
  tapEvents        TapEvent[]
  invitations      Invitation[]
  subscription     Subscription?
  stripeCustomer   StripeCustomer?
  settings         CompanySettings?

  // Soft-delete marker. A company is never hard-deleted; archived when its last
  // member archives their account. null = active.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@index([salesRepId])
}

/// Per-company preferences layered on top of the subscription plan.
model CompanySettings {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Collect anonymised tap analytics (taps, page views, review clicks).
  analyticsEnabled Boolean @default(true)
  // Default display language for public pages when a visitor has no preference.
  defaultLocale    String  @default("de")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyMember {
  id            String       @id @default(cuid())
  userId        String
  companyId     String
  role          CompanyRole  @default(MEMBER)
  permissions   Permission[] @default([])
  // Set when the member's user archives their account. null = active member.
  deactivatedAt DateTime?
  // Set when the company (or staff) removes the member. Kept for history; an
  // invitation reactivates the row. Separate from deactivatedAt so reclaiming
  // an archived account does not undo a removal.
  removedAt     DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([companyId, deactivatedAt])
  @@index([companyId, removedAt])
}

// ─── Locations (sites) ───────────────────────────────────────────────────────

// A physical site of a company (a restaurant, cafe, shop). Owns its own cards,
// pages, address and Google review target.
model Location {
  id        String  @id @default(cuid())
  name      String
  companyId String
  isDefault Boolean @default(false)

  // Address / locale
  address    String?
  city       String?
  postalCode String?
  country    String  @default("CH")
  timezone   String  @default("Europe/Zurich")

  // Google review integration (used by REVIEW pages by default).
  googlePlaceId   String?
  googleReviewUrl String?

  // Over the plan's location limit (after a downgrade). Kept with its cards and
  // pages, which stay live, but nothing on it can be changed. The customer
  // chooses which locations stay editable.
  readOnly Boolean @default(false)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cards   Card[]
  pages   Page[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft delete. Deleted rows are hidden everywhere but kept for history.
  deletedAt DateTime?

  @@index([companyId])
  @@index([companyId, deletedAt])
}

// ─── Pages (tap-destination content built in the builders) ───────────────────

// A single tap destination. `content` holds the builder output as validated
// JSON, shaped per `kind` (see the DTOs). A page has its own public slug so it
// can be shared directly, and cards point at it via Card.activePage.
model Page {
  id         String   @id @default(cuid())
  companyId  String
  locationId String?
  kind       PageKind
  name       String
  slug       String   @unique
  published  Boolean  @default(false)
  // Visual theme for the rendered page: { brandColor, background, logoUrl, ... }.
  theme      Json     @default("{}")
  // Kind-specific builder content (menu sections, links, wifi creds, ...).
  content    Json     @default("{}")

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location         Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  cards            Card[]
  tapEvents        TapEvent[]
  translationUsage TranslationUsage[]
  wifiGuests       WifiGuest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft delete. The slug stays reserved so an old link never shows other content.
  deletedAt DateTime?

  @@index([companyId])
  @@index([locationId])
  @@index([kind])
  @@index([companyId, deletedAt])
}

// A saved page design (logo, colours, fonts, header) a company reuses across
// its pages. Applying a template copies its theme into the page; later edits to
// the template do not change pages that already use it.
model DesignTemplate {
  id        String @id @default(cuid())
  companyId String
  name      String
  // Same shape as Page.theme.
  theme     Json   @default("{}")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Auto-translate usage (Claude Haiku), one row per page per calendar month.
// A company may translate a limited number of distinct pages per month; the
// request count caps spend within a page. Staff are exempt from the limits.
model TranslationUsage {
  id        String @id @default(cuid())
  companyId String
  pageId    String
  // UTC calendar month, e.g. "2026-09".
  month     String
  requests  Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, pageId, month])
  @@index([companyId, month])
  @@index([pageId])
}

// A guest who asked for the Wi-Fi password on a WIFI page with guest access
// on (Page.content.guestAccess). One row per page and email; repeat visits
// update it. The code fields hold the pending email code (hashed) in "verify"
// mode. Rows without marketing consent are deleted after 12 months of no visit.
model WifiGuest {
  id        String @id @default(cuid())
  companyId String
  pageId    String
  email     String
  // Language the guest saw the form (and the privacy note) in.
  locale    String @default("de")

  verified         Boolean   @default(false)
  verifiedAt       DateTime?
  // Opt-in to marketing emails from the business. Never pre-ticked.
  marketingConsent Boolean   @default(false)
  consentAt        DateTime?

  codeHash      String?
  codeExpiresAt DateTime?
  codeSentAt    DateTime?
  codeAttempts  Int       @default(0)

  visits     Int      @default(1)
  lastSeenAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, email])
  @@index([companyId, lastSeenAt])
}

// ─── Cards (physical NFC products) ───────────────────────────────────────────

model Card {
  id         String     @id @default(cuid())
  companyId  String
  locationId String?
  name       String
  type       CardType
  // Optional zone inside the location ("Terrasse", "Saal", "Bar"), so a
  // restaurant with many tables can group its cards.
  area       String?
  // Short name printed/encoded on the card, unique within the company. Tap URL
  // /c/<company slug>/<slug>.
  slug       String
  // Cards created before per-company links answer the old /c/<slug> URL too
  // (their slugs were globally unique then). New cards never do.
  legacyPath Boolean    @default(false)
  // Optional hardware UID of the NFC chip (for provisioning/verification).
  uid        String?    @unique
  status     CardStatus @default(UNASSIGNED)
  // Physical/landing design: { template, logoUrl, primaryColor, textColor, finish }.
  design     Json       @default("{}")

  // The page a tap currently routes to. Re-pointable at any time ("change
  // destination anytime").
  activePageId String?
  activePage   Page?   @relation(fields: [activePageId], references: [id], onDelete: SetNull)
  // Or a custom link instead of a page (web address, tel:, mailto:, sms:). A tap
  // is recorded, then the visitor is sent straight there. Never set together
  // with activePageId.
  linkUrl      String?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location  Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tapEvents TapEvent[]

  // The shop order this physical card was produced for, if any.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft delete. The slug stays reserved so a printed card is never reused.
  deletedAt DateTime?

  @@unique([companyId, slug])
  // Old-style /c/<slug> links look cards up by slug alone.
  @@index([slug])
  @@index([companyId])
  @@index([locationId])
  @@index([activePageId])
  @@index([orderId])
  @@index([companyId, deletedAt])
}

// ─── Analytics ───────────────────────────────────────────────────────────────

// One row per public tap / page view. Written from the unauthenticated public
// endpoint via the privileged bypass (no tenant context there), read under RLS
// on the dashboard.
model TapEvent {
  id         String    @id @default(cuid())
  companyId  String
  cardId     String?
  pageId     String?
  kind       PageKind?
  // Coarse client signal for the dashboard (no PII stored).
  country    String?
  deviceType String?
  referrer   String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  card    Card?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  page    Page?   @relation(fields: [pageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([cardId])
  @@index([pageId])
}

// ─── Invitations ─────────────────────────────────────────────────────────────

model Invitation {
  id          String           @id @default(cuid())
  email       String
  companyId   String
  role        CompanyRole      @default(MEMBER)
  token       String           @unique
  code        String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  invitedById String

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([email])
}

// ─── Billing (plan gating; Stripe integration is optional/light) ─────────────

// Global price catalogue, shared by all tenants (NOT row-level secured).
model SubscriptionPlan {
  id         String          @id @default(cuid())
  tier       PlanTier        @unique
  name       String
  // Price in Rappen (CHF cents). 0 for the system/free baseline.
  priceCents Int             @default(0)
  interval   BillingInterval @default(MONTHLY)
  // Feature flags/limits resolved by the billing service. e.g.
  // { multiLocation, analytics, unlimitedDestinationChanges, maxLocations }.
  features   Json            @default("{}")

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Physical cards sold on the marketing site (global, NOT row-level secured).
// `key` matches the website's card type ("business", "review").
model Product {
  id         String  @id @default(cuid())
  key        String  @unique
  name       String
  // Base price per card in Rappen (CHF cents), before volume discounts.
  priceCents Int
  // Units left to sell. null = unlimited. Decremented as website orders come
  // in; at 0 the site shows the product as currently not available.
  stock      Int?
  // Manual switch to take a product off sale regardless of stock.
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Shop ────────────────────────────────────────────────────────────────────

// A card order from the website (guest) or the app. Guest orders have no
// company until the buyer links them from the app (matched by verified email).
// Not row-level secured: companyId is null for guest orders, so access is
// checked in OrdersService (member of the company, or staff).
model Order {
  id     String @id @default(cuid())
  // Human-readable reference shown to customers, e.g. "TPL-7K3M9Q".
  number String @unique

  email           String
  customerName    String
  phone           String?
  companyName     String?
  // { line1, line2?, postalCode, city, country }
  shippingAddress Json
  locale          String  @default("de")

  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  placedByUserId String?

  // Staff member who claimed the order in the admin console and fulfils it.
  // Claiming also makes them the sales rep of the order's business.
  handledById String?
  handledBy   User?     @relation("OrderHandler", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime?

  status OrderStatus @default(PENDING_PAYMENT)

  subtotalCents Int
  discountCents Int
  shippingCents Int    @default(0)
  totalCents    Int
  currency      String @default("CHF")

  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  trackingNumber        String?

  paidAt          DateTime?
  claimedAt       DateTime?
  shippedAt       DateTime?
  cancelledAt     DateTime?
  // Set once reserved stock has been given back (expired/cancelled), so it is
  // never released twice.
  stockReleasedAt DateTime?

  items OrderItem[]
  cards Card[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([companyId])
  @@index([status])
  @@index([handledById])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productKey      String
  productName     String
  quantity        Int
  unitPriceCents  Int
  // Volume discount applied, in percent (e.g. 10).
  discountPercent Int    @default(0)
  lineTotalCents  Int
  // The customer's card design (the editor's CardConfig, logo as data URL).
  design          Json   @default("{}")

  createdAt DateTime @default(now())

  @@index([orderId])
}

model Subscription {
  id        String @id @default(cuid())
  companyId String @unique
  planId    String

  status   SubscriptionStatus @default(ACTIVE)
  source   SubscriptionSource @default(SYSTEM)
  interval BillingInterval    @default(MONTHLY)

  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime

  stripeSubscriptionId String?   @unique
  // Set when a Stripe subscription is scheduled to end (cancelled in the
  // billing portal). The plan stays active until then.
  cancelAt             DateTime?

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
}

model StripeCustomer {
  id               String @id @default(cuid())
  companyId        String @unique
  stripeCustomerId String @unique

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
