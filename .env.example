# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3311

# Postgres (docker-compose exposes it on 5434). The app connects as the owner and
# drops into the RLS-bound `taplino_app` role per query.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/taplino
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

# ─── better-auth ─────────────────────────────────────────────────────────────
# 32-byte base64 secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-in-production
# Base URL of THIS api service (OAuth redirects, passkey RP resolution).
BETTER_AUTH_URL=http://localhost:3311
# Comma-separated web origins (CORS + auth trusted origins). The FIRST entry is the
# customer app and is used for links in emails; add the admin console after it,
# e.g. https://app.taplino.ch,https://admin.taplino.ch
# In dev the admin console runs on http://admin.localhost:3312 (trusted automatically).
FRONTEND_URL=http://localhost:3310
TRUSTED_ORIGINS=
# Custom scheme for a future native app.
APP_SCHEME=taplinoapp://

# ─── Passkeys (WebAuthn) ─────────────────────────────────────────────────────
# rpID must be the registrable domain shared by web + native (localhost in dev).
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Taplino
PASSKEY_ORIGINS=http://localhost:3310,http://admin.localhost:3312
# Off by default so the backend can ship ahead of the app's passkey flows.
PASSKEY_ENFORCEMENT=false

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
EMAIL_FROM=noreply@taplino.ch
# Use Resend in prod; SMTP (mailpit) in dev.
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1027

# ─── Public rendering ────────────────────────────────────────────────────────
# Where the public tap pages are served (the Next.js app). Used to build share
# URLs and QR targets. e.g. https://taplino.ch
PUBLIC_BASE_URL=http://localhost:3310

# ─── Shop ────────────────────────────────────────────────────────────────────
# Marketing site base URL (Stripe success/cancel redirects for guest orders).
WEBSITE_URL=http://localhost:3000
# Inbox notified about every paid shop order (sent via Resend when
# RESEND_API_KEY is set). Defaults to orders@taplino.ch.
ORDERS_EMAIL=orders@taplino.ch
# Without STRIPE_SECRET_KEY outside production, checkout is simulated: orders
# are marked paid immediately so the flow can be tested locally.

# ─── Stripe (optional; billing is plan-gated even without it) ────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook endpoint: POST /api/v1/billing/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
#  checkout.session.async_payment_failed, checkout.session.expired)

# ─── API docs ────────────────────────────────────────────────────────────────
DOCS_ENABLED=true
